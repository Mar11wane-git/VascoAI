# Configuration de Vasco AI Agent
# Les clés peuvent aussi être saisies dans l'interface (bouton « Clés API »).

# --- Moteur gratuit (Vasco Cloud / Pollinations) ---
# Sans clé : limité à 1 réponse toutes les 45 s par IP (l'agent fait alors un seul tour d'outils).
# Clé gratuite sur https://enter.pollinations.ai : agent multi-étapes sans attente.
POLLINATIONS_API_KEY=

# --- Fournisseurs avec clé ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Outils de l'agent ---
# Exécution de code Python par l'agent (bac à sable : sous-processus isolé, dossier temporaire, délai max).
# Désactivé par défaut : ce n'est PAS une isolation forte. Ne l'activez que sur une machine de confiance,
# jamais sur un serveur public ouvert aux inscriptions.
AGENT_CODE_EXECUTION=false
AGENT_CODE_TIMEOUT=20

# URL publique de l'application (incluse dans le User-Agent des requêtes web, exigé par Wikipedia).
APP_URL=http://localhost:8000
