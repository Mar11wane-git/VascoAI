# Configuration de Vasco AI Agent
# Les clés peuvent aussi être saisies dans l'interface (bouton « Clés API »).

# --- Moteur gratuit (Vasco Cloud / Pollinations) ---
# Sans clé : limité à 1 réponse toutes les 45 s par IP (l'agent fait alors un seul tour d'outils).
# Clé gratuite sur https://enter.pollinations.ai : agent multi-étapes sans attente.
POLLINATIONS_API_KEY=

# --- Fournisseurs avec clé ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Outils de l'agent ---
# Exécution de code Python par l'agent (bac à sable : sous-processus isolé, dossier temporaire, délai max).
# Désactivé par défaut : ce n'est PAS une isolation forte. Ne l'activez que sur une machine de confiance,
# jamais sur un serveur public ouvert aux inscriptions.
AGENT_CODE_EXECUTION=false
AGENT_CODE_TIMEOUT=20

# URL publique de l'application (incluse dans le User-Agent des requêtes web, exigé par Wikipedia).
APP_URL=http://localhost:8000

# --- Base de donnees MySQL (comptes, profils, sessions, statistiques) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=Vasco

# --- Mise en ligne (production) ---
# APP_URL (plus haut) = l'adresse publique, ex. https://vasco-production.up.railway.app
# Hébergeurs MySQL qui donnent une seule URL (Railway…) : remplace MYSQL_HOST/PORT/USER/PASSWORD/DATABASE
# MYSQL_URL=mysql://user:motdepasse@hote:3306/base
# Ou PostgreSQL (ex. base Neon créée depuis Vercel) — utilisé seulement si aucune variable MYSQL_* n'est définie
# DATABASE_URL=postgresql://user:motdepasse@hote/base?sslmode=require
# E-mails autorisés à modifier les clés API depuis l'interface (séparés par des virgules)
ADMIN_EMAILS=
# Connexion Google / GitHub sur votre domaine (créer vos propres applications OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=